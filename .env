# ============================================================
# Realtime Streaming Pipeline — Environment Variables
# ============================================================

# --- Kafka ---
KAFKA_BROKER=kafka:9092
KAFKA_BROKER_EXTERNAL=localhost:9092
KAFKA_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=1
KAFKA_RETENTION_MS=604800000

# --- Zookeeper ---
ZOOKEEPER_PORT=2181

# --- Flink ---
FLINK_JOBMANAGER_PORT=8081
FLINK_JOBMANAGER_RPC_ADDRESS=jobmanager

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TTL_SECONDS=86400

# --- Elasticsearch ---
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX=revenue-by-minute

# --- Kibana ---
KIBANA_PORT=5601

# --- Producer ---
EVENTS_PER_SECOND=100
PURCHASE_TOPIC=purchase-events
CLICK_TOPIC=click-events
