# ============================================================
# Crypto Streaming Pipeline — Environment Variables
# ============================================================
# Copy this file to `.env` if you want to override defaults.
# In the default `docker compose up -d` flow you do NOT need
# a .env file — these values are already set inside the compose
# file for inter-container networking. This example is here for
# running individual services locally, outside Docker.
# ============================================================

# Kafka bootstrap servers
#   Inside Docker containers: kafka:9092
#   From host (running a service on your laptop directly): localhost:29092
KAFKA_BROKER=localhost:29092

# Redis host
#   Inside Docker containers: redis
#   From host: localhost
REDIS_HOST=localhost

# Elasticsearch endpoint
#   Inside Docker containers: http://elasticsearch:9200
#   From host: http://localhost:9200
ES_HOST=http://localhost:9200
